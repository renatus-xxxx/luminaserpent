# Makefile.linux - Linux build for LUMINA SERPENT (MSX2/MSX2+ / z88dk)
#
# The shipped build (SCREEN 8):
#   zcc +msx -create-app -O3 -subtype=msxdos -DMSX -lm \
#       src/main.c src/msxclib.c src/msxalib.c -bn LUMINA.COM
#   python3 tools/make_dsk.py <try16 template DSK> LUMINA.COM \
#       LUMINA.DSK data/tpl8.dat data/gpl8.dat data/gplf8.dat \
#       data/logo.dat data/spark.dat
# (the Earth images - title, in-game corner crop, and the
# full-disc version for the V9958 scroll ring - the title
# logo mask and the spark explosion frames are streamed from
# the data/*.dat files on the disk.)
#
# Libraries: msxalib.{h,c} / msxclib.{h,c} by yamayamaru
# (yamayamaru-storage-place, source-code_2023-09-30).
# NOTE: msxalib.c GETSTAT carries a local patch (B = 0 forced on
# its VDP port accesses); see the comment at GETSTAT in the source.
#
# Two deliverables from the same .COM:
#   make dsk   -> build-linux/LUMINA.DSK  (720 KB floppy, day-to-day checks)
#   make rom   -> build-linux/LUMINA.ROM  (LSX-Dodgers cartridge for
#                 MSX Simple Mega Flash: ASCII 8K mapper, auto-boots
#                 into the game via the GO.COM stub loader;
#                 see tools/make_rom.py, tools/lsx/ and
#                 tools/ROM-NOTES.md)
#   make both  -> both of the above (or run ./build_both.sh)
#   make rom-lite -> build-linux/LUMINA-LITE.ROM (Tablacus DISK
#                 ROM Lite cartridge using the locally patched
#                 DISKROM64K.BIN in tools/tablacus/: 8 KB system +
#                 dos2formsx game disk, AUTOEXEC auto-boots the
#                 game; see tools/make_rom_lite.py)

Z88DK_DIR ?= $(abspath $(dir $(lastword $(MAKEFILE_LIST)))../../../z88dk)
export ZCCCFG := $(Z88DK_DIR)/lib/config
export PATH   := $(Z88DK_DIR)/bin:$(PATH)

BUILD  := build-linux
TARGET := $(BUILD)/LUMINA.COM
DSK    := $(BUILD)/LUMINA.DSK
SRCS   := src/main.c src/msxclib.c src/msxalib.c
HDRS   := src/msxalib.h src/msxclib.h src/font.h src/title_img.h src/deepfield.h
DEFS   :=
DATA8  := data/tpl8.dat data/gpl8.dat data/gplf8.dat data/logo.dat data/spark.dat
DSK_TEMPLATE := $(dir $(lastword $(MAKEFILE_LIST)))../try16/bin/TRY16.DSK
DSK_TOOL := tools/make_dsk.py
ROM    := $(BUILD)/LUMINA.ROM
ROMSYS := tools/lsx/LDMSX.BIN
ROMGO  := tools/lsx/GO.COM
ROM_TOOL := tools/make_rom.py
LITEROM := $(BUILD)/LUMINA-LITE.ROM
LITESYS := tools/tablacus/DISKROM64K.BIN
LITETPL := tools/tablacus/DOS2FORMSX.DSK
LITE_TOOL := tools/make_rom_lite.py

all: $(TARGET)

$(TARGET): $(SRCS) $(HDRS)
	mkdir -p $(BUILD)
	rm -f $(BUILD)/LUMINA.img
	cd $(BUILD) && zcc +msx -create-app -O3 -subtype=msxdos -DMSX $(DEFS) -lm -I../src ../src/main.c ../src/msxclib.c ../src/msxalib.c -bn LUMINA.COM
	rm -f $(BUILD)/LUMINA.img

dsk: $(DSK)

$(DSK): $(TARGET) $(DSK_TEMPLATE) $(DSK_TOOL) $(DATA8)
	python3 $(DSK_TOOL) $(DSK_TEMPLATE) $(TARGET) $(DSK) $(DATA8)

rom: $(ROM)

$(ROM): $(DSK) $(ROMSYS) $(ROMGO) $(ROM_TOOL)
	python3 $(ROM_TOOL) $(ROMSYS) $(ROMGO) $(DSK) $(ROM)

both: dsk rom

rom-lite: $(LITEROM)

$(LITEROM): $(TARGET) $(LITESYS) $(LITETPL) $(LITE_TOOL) $(DATA8)
	python3 $(LITE_TOOL) $(LITESYS) $(LITETPL) $(TARGET) $(LITEROM) $(DATA8)

clean:
	rm -rf $(BUILD)

.PHONY: all dsk rom both rom-lite clean
